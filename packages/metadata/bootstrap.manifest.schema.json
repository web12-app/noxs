{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Noxs bootstrap manifest",
  "type": "object",
  "required": ["schema", "arch", "rootfs", "proot"],
  "properties": {
    "schema": { "const": 1 },
    "arch": { "enum": ["arm64-v8a", "armeabi-v7a", "x86_64"] },
    "rootfs": {
      "type": "object",
      "required": ["url"],
      "properties": {
        "url": { "type": "string", "pattern": "^https://|^file://" },
        "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$|^$" },
        "format": { "type": "string", "enum": ["tar.xz", "tar.gz", "tar"] },
        "sizeBytes": { "type": "integer", "minimum": 0 }
      }
    },
    "proot": {
      "type": "object",
      "required": ["url"],
      "properties": {
        "url": { "type": "string", "pattern": "^https://|^file://" },
        "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$|^$" }
      }
    },
    "generatedAt": { "type": "string" },
    "source": { "type": "string" },
    "note": { "type": "string" }
  },
  "additionalProperties": false
}
