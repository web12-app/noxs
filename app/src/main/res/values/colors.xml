<?xml version="1.0" encoding="utf-8"?>
<!--
  Noxs design system — mobile-first dark palette.
  Backgrounds are layered: pure black canvas, #111111 panels, #191919
  navigation, #222222 elevated surfaces, #303030 borders. The single accent
  (#20D866) marks interactive/positive state; warning and error are reserved
  for session/exit states and destructive actions.
-->
<resources>
    <!-- Surfaces -->
    <color name="noxs_background">#FF000000</color>
    <color name="noxs_panel">#FF111111</color>
    <color name="noxs_nav">#FF191919</color>
    <color name="noxs_elevated">#FF222222</color>
    <color name="noxs_border">#FF303030</color>
    <!-- Compatibility aliases used across the existing layouts -->
    <color name="noxs_surface">#FF111111</color>
    <color name="noxs_surface_alt">#FF191919</color>
    <color name="noxs_surface_variant">#FF222222</color>

    <!-- Text -->
    <color name="noxs_primary">#FF20D866</color>
    <color name="noxs_on_primary">#FF04150A</color>
    <color name="noxs_primary_container">#FF222222</color>
    <color name="noxs_on_primary_container">#FFFFFFFF</color>
    <color name="noxs_secondary">#FFAAAAAA</color>
    <color name="noxs_on_secondary">#FF111111</color>
    <color name="noxs_secondary_container">#FF303030</color>
    <color name="noxs_on_secondary_container">#FFE2E2E2</color>
    <color name="noxs_tertiary">#FF8A8A8A</color>
    <color name="noxs_on_tertiary">#FF111111</color>
    <color name="noxs_tertiary_container">#FF2A2A2A</color>
    <color name="noxs_on_tertiary_container">#FFF5F5F5</color>
    <color name="noxs_text">#FFFFFFFF</color>
    <color name="noxs_text_dim">#FFAAAAAA</color>

    <!-- Accent + semantic states -->
    <color name="noxs_accent">#FF20D866</color>
    <color name="noxs_on_accent">#FF04150A</color>
    <color name="noxs_warning">#FFFFB020</color>
    <color name="noxs_error">#FFFF5252</color>
    <color name="noxs_on_error">#FF160505</color>
    <color name="noxs_error_container">#FF3A1414</color>
    <color name="noxs_on_error_container">#FFFFD9D9</color>
    <color name="noxs_ok">#FF20D866</color>
    <color name="noxs_warn">#FFFFB020</color>
    <color name="noxs_outline">#FF6B6B6B</color>
    <color name="noxs_outline_variant">#FF303030</color>
    <!-- Setup console status indicator (matches the in-terminal ANSI palette) -->
    <color name="noxs_status_ok">#FF20D866</color>
    <color name="noxs_status_warn">#FFFFB020</color>
    <color name="noxs_status_err">#FFFF5252</color>
    <color name="ic_launcher_background">#FF000000</color>
</resources>
