<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.Noxs" parent="Theme.Material3.Dark.NoActionBar">
        <item name="colorPrimary">@color/noxs_accent</item>
        <item name="colorOnPrimary">@color/noxs_on_accent</item>
        <item name="colorPrimaryContainer">@color/noxs_elevated</item>
        <item name="colorOnPrimaryContainer">@color/noxs_on_primary_container</item>
        <item name="colorSecondary">@color/noxs_secondary</item>
        <item name="colorOnSecondary">@color/noxs_on_secondary</item>
        <item name="colorSecondaryContainer">@color/noxs_secondary_container</item>
        <item name="colorOnSecondaryContainer">@color/noxs_on_secondary_container</item>
        <item name="colorTertiary">@color/noxs_tertiary</item>
        <item name="colorOnTertiary">@color/noxs_on_tertiary</item>
        <item name="colorTertiaryContainer">@color/noxs_tertiary_container</item>
        <item name="colorOnTertiaryContainer">@color/noxs_on_tertiary_container</item>
        <item name="colorSurface">@color/noxs_panel</item>
        <item name="colorOnSurface">@color/noxs_text</item>
        <item name="colorSurfaceVariant">@color/noxs_elevated</item>
        <item name="colorOnSurfaceVariant">@color/noxs_text_dim</item>
        <item name="colorError">@color/noxs_error</item>
        <item name="colorOnError">@color/noxs_on_error</item>
        <item name="colorErrorContainer">@color/noxs_error_container</item>
        <item name="colorOnErrorContainer">@color/noxs_on_error_container</item>
        <item name="colorOutline">@color/noxs_outline</item>
        <item name="colorOutlineVariant">@color/noxs_border</item>
        <item name="android:colorAccent">@color/noxs_accent</item>
        <item name="android:colorBackground">@color/noxs_background</item>
        <item name="android:statusBarColor">@color/noxs_background</item>
        <item name="android:navigationBarColor">@color/noxs_background</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>

    <!-- Typography -->
    <style name="Text.Noxs.Title" parent="TextAppearance.Material3.HeadlineMedium">
        <item name="android:textColor">@color/noxs_text</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="Text.Noxs.Body" parent="TextAppearance.Material3.BodyMedium">
        <item name="android:textColor">@color/noxs_text_dim</item>
    </style>

    <style name="Text.Noxs.Mono" parent="TextAppearance.Material3.BodySmall">
        <item name="android:textColor">@color/noxs_text</item>
        <item name="android:fontFamily">monospace</item>
    </style>

    <!-- Compact pill button used across the terminal chrome (28dp tall). -->
    <style name="Text.Noxs.PillButton" parent="Text.Noxs.Mono">
        <item name="android:gravity">center</item>
        <item name="android:textSize">12sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:paddingStart">12dp</item>
        <item name="android:paddingEnd">12dp</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
    </style>

    <!-- Drawer navigation: uniform 48dp row, 22dp icon, aligned label -->
    <style name="Text.Noxs.NavRow" parent="">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">48dp</item>
        <item name="android:orientation">horizontal</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:paddingStart">16dp</item>
        <item name="android:paddingEnd">16dp</item>
        <item name="android:background">?attr/selectableItemBackground</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
    </style>

    <style name="Text.Noxs.NavIcon" parent="">
        <item name="android:layout_width">22dp</item>
        <item name="android:layout_height">22dp</item>
        <item name="android:tint">@color/noxs_text_dim</item>
        <item name="android:importantForAccessibility">no</item>
    </style>

    <style name="Text.Noxs.NavLabel" parent="">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginStart">16dp</item>
        <item name="android:textColor">@color/noxs_text</item>
        <item name="android:textSize">14sp</item>
        <item name="android:maxLines">1</item>
    </style>
</resources>
