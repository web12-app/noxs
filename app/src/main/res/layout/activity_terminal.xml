<?xml version="1.0" encoding="utf-8"?>
<androidx.drawerlayout.widget.DrawerLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/drawer"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true"
    android:background="@color/noxs_background">

    <!-- Main terminal column: header + actions + session tabs + terminal canvas + extra keys -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:background="@color/noxs_background">

        <!-- Top header & resource status bar -->
        <LinearLayout
            android:id="@+id/status_bar"
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="8dp"
            android:paddingEnd="10dp"
            android:background="@color/noxs_surface">

            <TextView
                android:id="@+id/btn_drawer"
                style="@style/Text.Noxs.Mono"
                android:layout_width="wrap_content"
                android:layout_height="30dp"
                android:gravity="center"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:background="@color/noxs_surface_alt"
                android:text="☰ Menu"
                android:textColor="@color/noxs_primary"
                android:textStyle="bold"
                android:textSize="12sp" />

            <View
                android:id="@+id/status_dot"
                android:layout_width="8dp"
                android:layout_height="8dp"
                android:layout_marginStart="10dp"
                android:background="@color/noxs_ok" />

            <TextView
                android:id="@+id/status_session"
                style="@style/Text.Noxs.Mono"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:text="@string/app_name"
                android:textStyle="bold"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/status_proc"
                style="@style/Text.Noxs.Mono"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:contentDescription="@string/status_proc_desc"
                android:text=""
                android:textColor="@color/noxs_text_dim"
                android:textSize="11sp" />

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <TextView
                android:id="@+id/status_cpu"
                style="@style/Text.Noxs.Mono"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="CPU 0%"
                android:textSize="11sp" />

            <TextView
                android:id="@+id/status_mem"
                style="@style/Text.Noxs.Mono"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="MEM 0 MB"
                android:textSize="11sp" />

            <TextView
                android:id="@+id/status_storage"
                style="@style/Text.Noxs.Mono"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="0 MB"
                android:textSize="11sp" />
        </LinearLayout>

        <!-- Visible Actions Toolbar (always visible so user can create sessions, run actions & open managers) -->
        <HorizontalScrollView
            android:id="@+id/actions_scroll"
            android:layout_width="match_parent"
            android:layout_height="38dp"
            android:scrollbars="none"
            android:background="@color/noxs_surface_alt">

            <LinearLayout
                android:id="@+id/actions_bar"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingStart="8dp"
                android:paddingEnd="8dp">

                <TextView
                    android:id="@+id/btn_action_new_shell"
                    style="@style/Text.Noxs.Mono"
                    android:layout_width="wrap_content"
                    android:layout_height="28dp"
                    android:gravity="center"
                    android:paddingStart="10dp"
                    android:paddingEnd="10dp"
                    android:layout_marginEnd="6dp"
                    android:background="@color/noxs_primary"
                    android:text="@string/action_new_shell"
                    android:textColor="@color/noxs_on_primary"
                    android:textStyle="bold"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/btn_action_new_root"
                    style="@style/Text.Noxs.Mono"
                    android:layout_width="wrap_content"
                    android:layout_height="28dp"
                    android:gravity="center"
                    android:paddingStart="10dp"
                    android:paddingEnd="10dp"
                    android:layout_marginEnd="6dp"
                    android:background="@color/noxs_surface"
                    android:text="@string/action_new_root"
                    android:textColor="@color/noxs_accent"
                    android:textStyle="bold"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/btn_action_activity"
                    style="@style/Text.Noxs.Mono"
                    android:layout_width="wrap_content"
                    android:layout_height="28dp"
                    android:gravity="center"
                    android:paddingStart="10dp"
                    android:paddingEnd="10dp"
                    android:layout_marginEnd="6dp"
                    android:background="@color/noxs_surface"
                    android:text="@string/action_center"
                    android:textStyle="bold"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/btn_action_copy"
                    style="@style/Text.Noxs.Mono"
                    android:layout_width="wrap_content"
                    android:layout_height="28dp"
                    android:gravity="center"
                    android:paddingStart="10dp"
                    android:paddingEnd="10dp"
                    android:layout_marginEnd="6dp"
                    android:background="@color/noxs_surface"
                    android:text="@string/action_copy"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/btn_action_paste"
                    style="@style/Text.Noxs.Mono"
                    android:layout_width="wrap_content"
                    android:layout_height="28dp"
                    android:gravity="center"
                    android:paddingStart="10dp"
                    android:paddingEnd="10dp"
                    android:layout_marginEnd="6dp"
                    android:background="@color/noxs_surface"
                    android:text="@string/action_paste"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/btn_action_clear"
                    style="@style/Text.Noxs.Mono"
                    android:layout_width="wrap_content"
                    android:layout_height="28dp"
                    android:gravity="center"
                    android:paddingStart="10dp"
                    android:paddingEnd="10dp"
                    android:layout_marginEnd="6dp"
                    android:background="@color/noxs_surface"
                    android:text="@string/action_clear"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/btn_action_packages"
                    style="@style/Text.Noxs.Mono"
                    android:layout_width="wrap_content"
                    android:layout_height="28dp"
                    android:gravity="center"
                    android:paddingStart="10dp"
                    android:paddingEnd="10dp"
                    android:layout_marginEnd="6dp"
                    android:background="@color/noxs_surface"
                    android:text="@string/nav_packages"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/btn_action_files"
                    style="@style/Text.Noxs.Mono"
                    android:layout_width="wrap_content"
                    android:layout_height="28dp"
                    android:gravity="center"
                    android:paddingStart="10dp"
                    android:paddingEnd="10dp"
                    android:layout_marginEnd="6dp"
                    android:background="@color/noxs_surface"
                    android:text="@string/nav_files"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/btn_action_services"
                    style="@style/Text.Noxs.Mono"
                    android:layout_width="wrap_content"
                    android:layout_height="28dp"
                    android:gravity="center"
                    android:paddingStart="10dp"
                    android:paddingEnd="10dp"
                    android:layout_marginEnd="6dp"
                    android:background="@color/noxs_surface"
                    android:text="@string/nav_services"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/btn_action_processes"
                    style="@style/Text.Noxs.Mono"
                    android:layout_width="wrap_content"
                    android:layout_height="28dp"
                    android:gravity="center"
                    android:paddingStart="10dp"
                    android:paddingEnd="10dp"
                    android:layout_marginEnd="6dp"
                    android:background="@color/noxs_surface"
                    android:text="@string/nav_processes"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/btn_action_settings"
                    style="@style/Text.Noxs.Mono"
                    android:layout_width="wrap_content"
                    android:layout_height="28dp"
                    android:gravity="center"
                    android:paddingStart="10dp"
                    android:paddingEnd="10dp"
                    android:layout_marginEnd="6dp"
                    android:background="@color/noxs_surface"
                    android:text="@string/nav_settings"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/btn_action_diagnostics"
                    style="@style/Text.Noxs.Mono"
                    android:layout_width="wrap_content"
                    android:layout_height="28dp"
                    android:gravity="center"
                    android:paddingStart="10dp"
                    android:paddingEnd="10dp"
                    android:layout_marginEnd="6dp"
                    android:background="@color/noxs_surface"
                    android:text="Diag"
                    android:textSize="12sp" />

            </LinearLayout>
        </HorizontalScrollView>

        <!-- Compact terminal toolbar: scroll / clipboard / search / font controls -->
        <HorizontalScrollView
            android:id="@+id/terminal_toolbar_scroll"
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:background="@color/noxs_surface"
            android:scrollbars="none">

            <LinearLayout
                android:id="@+id/terminal_toolbar"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="6dp"
                android:paddingEnd="6dp">

                <TextView
                    android:id="@+id/btn_scroll_top"
                    style="@style/Text.Noxs.Mono"
                    android:layout_width="40dp"
                    android:layout_height="36dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/terminal_scroll_top"
                    android:gravity="center"
                    android:text="↑"
                    android:textColor="@color/noxs_text"
                    android:textSize="14sp" />

                <TextView
                    android:id="@+id/btn_scroll_bottom"
                    style="@style/Text.Noxs.Mono"
                    android:layout_width="40dp"
                    android:layout_height="36dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/terminal_scroll_bottom"
                    android:gravity="center"
                    android:text="↓"
                    android:textColor="@color/noxs_text"
                    android:textSize="14sp" />

                <TextView
                    android:id="@+id/btn_tb_copy"
                    style="@style/Text.Noxs.Mono"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/action_copy"
                    android:gravity="center"
                    android:paddingStart="8dp"
                    android:paddingEnd="8dp"
                    android:text="@string/action_copy"
                    android:textColor="@color/noxs_text"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/btn_tb_paste"
                    style="@style/Text.Noxs.Mono"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/action_paste"
                    android:gravity="center"
                    android:paddingStart="8dp"
                    android:paddingEnd="8dp"
                    android:text="@string/action_paste"
                    android:textColor="@color/noxs_text"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/btn_tb_search"
                    style="@style/Text.Noxs.Mono"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/action_search"
                    android:gravity="center"
                    android:paddingStart="8dp"
                    android:paddingEnd="8dp"
                    android:text="@string/action_search"
                    android:textColor="@color/noxs_text"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/btn_font_decr"
                    style="@style/Text.Noxs.Mono"
                    android:layout_width="40dp"
                    android:layout_height="36dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/terminal_font_decrease"
                    android:gravity="center"
                    android:text="A−"
                    android:textColor="@color/noxs_text"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/font_size_label"
                    style="@style/Text.Noxs.Mono"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:contentDescription="@string/terminal_font_current"
                    android:gravity="center"
                    android:paddingStart="4dp"
                    android:paddingEnd="4dp"
                    android:text="14"
                    android:textColor="@color/noxs_accent"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/btn_font_incr"
                    style="@style/Text.Noxs.Mono"
                    android:layout_width="40dp"
                    android:layout_height="36dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/terminal_font_increase"
                    android:gravity="center"
                    android:text="A+"
                    android:textColor="@color/noxs_text"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/btn_tb_more"
                    style="@style/Text.Noxs.Mono"
                    android:layout_width="40dp"
                    android:layout_height="36dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/terminal_more"
                    android:gravity="center"
                    android:text="⋮"
                    android:textColor="@color/noxs_text"
                    android:textSize="14sp" />
            </LinearLayout>
        </HorizontalScrollView>

        <!-- Active session tabs -->
        <HorizontalScrollView
            android:id="@+id/session_tabs_scroll"
            android:layout_width="match_parent"
            android:layout_height="34dp"
            android:scrollbars="none"
            android:background="@color/noxs_surface">

            <LinearLayout
                android:id="@+id/session_tabs_row"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingStart="8dp"
                android:paddingEnd="8dp" />
        </HorizontalScrollView>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/noxs_surface_alt" />

        <!-- Interactive terminal canvas: Android IME input goes directly to the active PTY -->
        <FrameLayout
            android:id="@+id/terminal_container"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:background="@color/noxs_background">

            <com.crossberry.noxs.terminal.view.TerminalView
                android:id="@+id/terminal"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:focusable="true"
                android:focusableInTouchMode="true" />

            <!-- Output search bar (hidden until Search is tapped) -->
            <LinearLayout
                android:id="@+id/search_bar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="top"
                android:background="@color/noxs_surface"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="12dp"
                android:paddingTop="6dp"
                android:paddingEnd="8dp"
                android:paddingBottom="6dp"
                android:visibility="gone">

                <EditText
                    android:id="@+id/et_search"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:background="@null"
                    android:contentDescription="@string/terminal_search_hint"
                    android:fontFamily="monospace"
                    android:hint="@string/terminal_search_hint"
                    android:imeOptions="actionSearch|flagNoFullscreen"
                    android:inputType="text"
                    android:maxLines="1"
                    android:textColor="@color/noxs_text"
                    android:textColorHint="@color/noxs_text_dim"
                    android:textSize="13sp" />

                <TextView
                    android:id="@+id/tv_search_count"
                    style="@style/Text.Noxs.Mono"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:text=""
                    android:textColor="@color/noxs_text_dim"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/btn_search_prev"
                    style="@style/Text.Noxs.Mono"
                    android:layout_width="40dp"
                    android:layout_height="36dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/terminal_search_prev"
                    android:gravity="center"
                    android:text="↑"
                    android:textColor="@color/noxs_text"
                    android:textSize="14sp" />

                <TextView
                    android:id="@+id/btn_search_next"
                    style="@style/Text.Noxs.Mono"
                    android:layout_width="40dp"
                    android:layout_height="36dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/terminal_search_next"
                    android:gravity="center"
                    android:text="↓"
                    android:textColor="@color/noxs_text"
                    android:textSize="14sp" />

                <TextView
                    android:id="@+id/btn_search_close"
                    style="@style/Text.Noxs.Mono"
                    android:layout_width="40dp"
                    android:layout_height="36dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/action_close"
                    android:gravity="center"
                    android:text="✕"
                    android:textColor="@color/noxs_text"
                    android:textSize="13sp" />
            </LinearLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_terminal_latest"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:layout_gravity="bottom|end"
                android:layout_margin="16dp"
                android:backgroundTint="@color/noxs_primary"
                android:contentDescription="@string/terminal_latest"
                android:elevation="6dp"
                android:text="@string/terminal_latest"
                android:textAllCaps="false"
                android:textColor="@color/noxs_on_primary"
                android:visibility="gone"
                app:cornerRadius="20dp" />

        </FrameLayout>

        <com.crossberry.noxs.terminal.view.NoxsExtraKeysBar
            android:id="@+id/extra_keys"
            android:layout_width="match_parent"
            android:layout_height="72dp" />
    </LinearLayout>

    <!-- Drawer -->
    <com.google.android.material.navigation.NavigationView
        android:id="@+id/nav_view"
        android:layout_width="300dp"
        android:layout_height="match_parent"
        android:layout_gravity="start"
        android:background="@color/noxs_surface">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="16dp"
                android:text="@string/drawer_sessions"
                style="@style/Text.Noxs.Title" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:paddingStart="16dp"
                android:paddingEnd="16dp">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_new_session"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:text="@string/drawer_new_session"
                    android:textSize="12sp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_new_root"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:text="@string/drawer_new_root_session"
                    android:textSize="12sp" />
            </LinearLayout>

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/session_list"
                android:layout_width="match_parent"
                android:layout_height="180dp"
                android:padding="8dp" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="@color/noxs_surface_alt" />

            <ScrollView
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingBottom="24dp">

                    <TextView android:id="@+id/nav_files" style="@style/Text.Noxs.Mono" android:layout_width="match_parent" android:layout_height="wrap_content" android:padding="14dp" android:text="@string/nav_files" android:textSize="15sp" />
                    <TextView android:id="@+id/nav_plugins" style="@style/Text.Noxs.Mono" android:layout_width="match_parent" android:layout_height="wrap_content" android:padding="14dp" android:text="@string/nav_plugins" android:textSize="15sp" />
                    <TextView android:id="@+id/nav_packages" style="@style/Text.Noxs.Mono" android:layout_width="match_parent" android:layout_height="wrap_content" android:padding="14dp" android:text="@string/nav_packages" android:textSize="15sp" />
                    <TextView android:id="@+id/nav_users" style="@style/Text.Noxs.Mono" android:layout_width="match_parent" android:layout_height="wrap_content" android:padding="14dp" android:text="@string/nav_users" android:textSize="15sp" />
                    <TextView android:id="@+id/nav_activity" style="@style/Text.Noxs.Mono" android:layout_width="match_parent" android:layout_height="wrap_content" android:padding="14dp" android:text="@string/nav_activity_center" android:textSize="15sp" />
                    <TextView android:id="@+id/nav_processes" style="@style/Text.Noxs.Mono" android:layout_width="match_parent" android:layout_height="wrap_content" android:padding="14dp" android:text="@string/nav_processes" android:textSize="15sp" />
                    <TextView android:id="@+id/nav_services" style="@style/Text.Noxs.Mono" android:layout_width="match_parent" android:layout_height="wrap_content" android:padding="14dp" android:text="@string/nav_services" android:textSize="15sp" />
                    <TextView android:id="@+id/nav_env" style="@style/Text.Noxs.Mono" android:layout_width="match_parent" android:layout_height="wrap_content" android:padding="14dp" android:text="@string/nav_env" android:textSize="15sp" />
                    <TextView android:id="@+id/nav_storage" style="@style/Text.Noxs.Mono" android:layout_width="match_parent" android:layout_height="wrap_content" android:padding="14dp" android:text="@string/nav_storage" android:textSize="15sp" />
                    <TextView android:id="@+id/nav_security" style="@style/Text.Noxs.Mono" android:layout_width="match_parent" android:layout_height="wrap_content" android:padding="14dp" android:text="@string/nav_security" android:textSize="15sp" />
                    <TextView android:id="@+id/nav_settings" style="@style/Text.Noxs.Mono" android:layout_width="match_parent" android:layout_height="wrap_content" android:padding="14dp" android:text="@string/nav_settings" android:textSize="15sp" />
                    <TextView android:id="@+id/nav_diagnostics" style="@style/Text.Noxs.Mono" android:layout_width="match_parent" android:layout_height="wrap_content" android:padding="14dp" android:text="@string/nav_diagnostics" android:textSize="15sp" />
                    <TextView android:id="@+id/nav_about" style="@style/Text.Noxs.Mono" android:layout_width="match_parent" android:layout_height="wrap_content" android:padding="14dp" android:text="@string/nav_about" android:textSize="15sp" />
                </LinearLayout>
            </ScrollView>
        </LinearLayout>
    </com.google.android.material.navigation.NavigationView>
</androidx.drawerlayout.widget.DrawerLayout>
