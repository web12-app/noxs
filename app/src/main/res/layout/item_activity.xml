<?xml version="1.0" encoding="utf-8"?>
<!-- One tracked activity row: status chip + title + two dim meta lines -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="14dp"
    android:paddingEnd="14dp"
    android:paddingTop="8dp"
    android:paddingBottom="8dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/item_status"
            style="@style/Text.Noxs.Mono"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="12sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/item_title"
            style="@style/Text.Noxs.Mono"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:textSize="13sp"
            android:textColor="@color/noxs_primary"
            android:maxLines="1"
            android:ellipsize="end" />
    </LinearLayout>

    <TextView
        android:id="@+id/item_meta1"
        style="@style/Text.Noxs.Mono"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="34dp"
        android:textSize="11.5sp"
        android:textColor="@color/noxs_text_dim"
        android:maxLines="1"
        android:ellipsize="end" />

    <TextView
        android:id="@+id/item_meta2"
        style="@style/Text.Noxs.Mono"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="34dp"
        android:textSize="11.5sp"
        android:textColor="@color/noxs_text_dim"
        android:maxLines="1"
        android:ellipsize="end" />
</LinearLayout>
