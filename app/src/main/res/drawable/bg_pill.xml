<?xml version="1.0" encoding="utf-8"?>
<!-- Elevated pill button: #222222 surface, #303030 border, subtle press ripple -->
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="#33FFFFFF">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/noxs_elevated" />
            <stroke android:width="1dp" android:color="@color/noxs_border" />
            <corners android:radius="8dp" />
        </shape>
    </item>
</ripple>
