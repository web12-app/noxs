# Gradle
.gradle/
build/
*/build/
local.properties

# IDE
.idea/
*.iml
.DS_Store
captures/

# Native
.cxx/
*.so
# Bundled proot + private libs are redistributed in jniLibs (exec-allowed
# location on Android 10+); keep them versioned.
!app/src/main/jniLibs/**/*.so

# Bootstrap staging (large artifacts are produced by scripts/build-rootfs.sh)
linux-runtime/bootstrap/**/rootfs.tar.*
linux-runtime/bootstrap/**/proot
linux-runtime/bootstrap/**/*.sha256.staged

# Runtime logs
*.log
